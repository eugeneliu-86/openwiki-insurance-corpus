    {
      "id": "claim_ac3f54795f0643db93e96a69224eecf3",
      "statement": "Occurrence or loss-event language controls aggregation: related windstorm or hail damage from the same weather event is generally treated as one occurrence or loss event, while separate weather events may receive separate deductibles; later discovery alone does not create a new event.",
      "evidence": [
        {
          "resource": "repo://forms/HO/LA/HO-01-17/2020-09.md#L95-L99",
          "version": "repo-lines-v1:sha256:86238e5db2bea2a2f500cda0bd545b93375b3be5d578fa2d0e07fd49ec6772b7:"
