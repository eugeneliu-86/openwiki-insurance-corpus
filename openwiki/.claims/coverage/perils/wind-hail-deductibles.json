  "claims": [
    {
      "id": "claim_d688cb7db80d49638269b9d49b0057f7",
      "statement": "A windstorm or hail deductible applies only to covered direct physical loss to covered property; it does not create coverage or override an exclusion. The current HO-3 covers direct physical loss caused by windstorm and hail subject to exclusions and conditions, and HO 23 77 2022-07 expressly preserves otherwise uncovered property, loss, and damage.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-23-77/2022-07.md#L25-L43",
          "version": "repo-lines-v1:sha256:f2913dae145d894263489281abfe80e318b1448c1aa4431f9fec140df1bc33a1:"
        },
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L625-L633",
          "version": "repo-lines-v1:sha256:31f710a8513891ff79ec6b3003361d3e91d1815b0accb8963fd6cf93d0cf7dd6:"
        }
      ]
    },
    {
      "id": "claim_c43f051c574547d39ef4d9fe268eb465",
      "statement": "Under the current HO-3 opening rule, wind-driven rain, snow, sleet, sand, or dust entering a building is covered only when the direct force of wind or hail first damages the building and creates an opening; the deductible does not itself make water damage covered.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-23-77/2022-07.md#L87-L91",
          "version": "repo-lines-v1:sha256:56bae3525d274c5170cea39dccf023fa65dd39b8d8a8ff400e70aea087979ac6:"
        },
