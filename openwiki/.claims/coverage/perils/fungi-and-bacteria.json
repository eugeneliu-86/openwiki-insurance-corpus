        }
      ]
    },
    {
      "id": "claim_2bba3f8c8410473db80683cd62b2840e",
      "statement": "HO 04 81 covers fungi-related direct physical loss only when a covered cause first causes direct physical loss to covered property and the fungi-related loss results from that physical loss; fungi loss that does not result from a covered cause is not covered.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-81/2018-09.md#L47-L63",
          "version": "repo-lines-v1:sha256:4af9f340c0a9c800152712c73523b10f1b0adbe9a4f1037361cd3fdd1bde45e4:"
        }
      ]
    },
    {
      "id": "claim_03a1e7f9bc3e4b54b95a1681fab6b9f6",
      "statement": "When the HO 04 81 coverage trigger is satisfied, its expressly covered costs can include direct physical loss to covered property, reasonable and necessary removal, tear-out and replacement needed to access or repair covered property, post-remediation air or property testing when there is reason to believe fungi remain, and reasonable and necessary remediation related to covered direct physical loss.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-81/2018-09.md#L49-L77",
          "version": "repo-lines-v1:sha256:fcb6c62ae1a0cba2e3bc8592e3e882be114825437c02654acd3481476334aafb:"
        }
      ]
    },
    {
      "id": "claim_c484a3bfab544204a12501c9e95b51ce",
      "statement": "Under HO 04 81, remediation is defined broadly as measures to remove, contain, treat, clean, dispose of, or otherwise address fungi, but it is covered only when reasonable and necessary for fungi for which coverage is provided and when related to covered direct physical loss.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-81/2018-09.md#L71-L77",
          "version": "repo-lines-v1:sha256:5ea72e0ab746fc2be30dd8013d8696e5d2f5593a5dd3ab1cc2b6dd021eebe493:"
        }
      ]
    },
    {
      "id": "claim_40b6062d79b24cf9b7a62ebfe1769d37",
      "statement": "HO 04 81 excludes fungi loss arising from constant or repeated seepage or leakage, constant or repeated discharge or overflow, flood, preexisting conditions, deterioration, decay, wear, neglect, inadequate maintenance, and defective work; it also preserves other policy exclusions unless the endorsement expressly changes them.",
      "evidence": [
