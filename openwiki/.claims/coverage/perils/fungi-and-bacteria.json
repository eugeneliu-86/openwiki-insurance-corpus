    {
      "id": "claim_599ec3e354d84b2bba2fd4869d67aedd",
      "statement": "The HO 04 81 2018-09 endorsement is a narrow modification of the base policy rather than blanket fungi coverage: the base HO-3 exclusion remains the starting point, while the endorsement says it modifies the policy, leaves other terms and exclusions in force unless changed, and provides no coverage beyond its express terms.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-81/2018-09.md#L121-L155",
          "version": "repo-lines-v1:sha256:8b6e5ca1ff1eb6025df5ab01c88120e91ef05b128a57cc88c9af2b5d9f161c47:"
