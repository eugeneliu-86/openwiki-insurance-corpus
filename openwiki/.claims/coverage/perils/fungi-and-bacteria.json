    {
      "id": "claim_c18fb8294e01496bacd3643b068b6119",
      "statement": "HO 04 27 Limited Water Damage Coverage 2016-05 is not a general fungi write-back: it covers specified water discharges and system or appliance events, expressly excludes loss caused by fungi, wet rot, dry rot, or bacteria, and separately states a $5,000 fungi-related amount that must be read with that exclusion rather than treated alone as a coverage grant.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-27/2016-05.md#L41-L71",
          "version": "repo-lines-v1:sha256:1e83382892a50bb4c0100e896e5aebc8978f7b4e4a5d80b891877d78882234e2:"
