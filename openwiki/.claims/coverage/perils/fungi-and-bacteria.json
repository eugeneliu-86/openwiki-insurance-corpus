    {
      "id": "claim_112462b9d4ee456389b614c13925e8cc",
      "statement": "For HO 04 81 edition 2018-09, the fungi, wet or dry rot, or bacteria aggregate limit is $10,000 for all covered loss during the policy term, applies to covered property and related covered costs across locations, claims, insureds, property types, causes, and occurrences, and is reduced by payments without restoration; costs above the aggregate are not covered.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-81/2018-09.md#L157-L169",
          "version": "repo-lines-v1:sha256:10333bce51e5b5756cfe4a57980d55eda30278d1d8eb859f0ab1f5e9744ee6de:"
