          "version": "repo-lines-v1:sha256:19cab75035eda145d42ba9bed3783e6f8fe371fbdb6b167fb1d11820fb422a9b:"
        },
        {
          "resource": "repo://manuals/claims/manual.md#L45-L55",
          "version": "repo-lines-v1:sha256:14ff55c6d4889232a9b7f7421acf771e6d9c999d886b3f40ddf94fa7611ef000:"
        }
      ]
    },
    {
      "id": "claim_a659067fd20b4b7b9ed5a58f03f71326",
      "statement": "Fungi and mold handling requires early identification of moisture, water intrusion, concealed damage, odor, staining, or growth; separation of direct physical loss from fungi-related damage; and collection of source, timing, inspection, photographic, invoice, remediation, and estimate evidence before characterizing claimed work as covered.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L15-L33",
          "version": "repo-lines-v1:sha256:a1808bf22e5e9b0926de7e5ad680b5d3350aabef5704bd8f62dbd54ab2c70104:"
        },
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L601-L635",
          "version": "repo-lines-v1:sha256:bc971152f8f4ff3341b7a5967ba7b36ff61b1ff4da61faa1ea31b2fe7cf62e75:"
        }
      ]
    },
    {
      "id": "claim_244e3189137e4c24bad1f1bb4d98a1f3",
      "statement": "The handling workflow separates prompt acknowledgment and reasonable protection from permanent repair or replacement, preserves samples and removed materials when relevant, and uses qualified experts when source, extent, contamination, or repair method cannot be reliably determined.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L601-L635",
          "version": "repo-lines-v1:sha256:bc971152f8f4ff3341b7a5967ba7b36ff61b1ff4da61faa1ea31b2fe7cf62e75:"
        }
      ]
    },
    {
      "id": "claim_737cf32e72a14fcf9c4201de39cf4e22",
      "statement": "Coverage determination for a fungi or mold report remains reserved until cause and applicable policy provisions are evaluated; handlers should make targeted requests, preserve communications, explain limitations or denials using policy language and material facts, and distinguish covered direct physical loss from maintenance, deterioration, humidity-control, preexisting, or other noncovered costs.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L645-L669",
          "version": "repo-lines-v1:sha256:92351b861833a57435af7f2c62aeb6ba20ac58acaa2ca9221e8696ac955be2f3:"
        },
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L651-L665",
          "version": "repo-lines-v1:sha256:9db0fbda4c3970c32ee645c17e469c3a95baedc88c21239df774ca9f958e5afe:"
        }
      ]
    },
    {
      "id": "claim_b92614cd8f7844be959a61f5ae97bcd4",
      "statement": "Fungi and mold matters must stay within assigned authority: investigation, inspection, mitigation, vendor activity, remediation, specialized testing, denials, reservations of rights, and settlements require the stated authority or referral, and an inspection, mitigation effort, vendor assignment, or payment does not itself establish coverage or resolve a formal coverage dispute.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L679-L709",
