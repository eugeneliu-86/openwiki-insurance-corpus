  "claims": [
    {
      "id": "claim_324609de2d014e5682a87ba708c53b66",
      "statement": "Base forms exclude fungi-related loss in edition-specific ways, and a microbial remediation limit or similar amount does not itself create coverage: HO-3 2024-03 excludes fungi, wet rot, dry rot, and bacteria while stating the microbial remediation limit does not create coverage for excluded loss; HO-4 2021-10 excludes those conditions whether visible or concealed; HO-5 2022-06 separately addresses fungi, fungi remediation costs, and bacteria or other microorganisms; HO-6 2023-02 excludes fungi, wet rot, dry rot, and bacteria except as provided by a limited fungi endorsement; and DP-3 2026-01 excludes presence, growth, spread, or removal of those conditions regardless of the contributing moisture source.",
      "evidence": [
        {
          "resource": "repo://forms/DP/MS/DP-3/2026-01.md#L739-L743",
          "version": "repo-lines-v1:sha256:495e9437a98cb355a0c8d5124381c69e0219707beb1f6e08de8e5713eb5cfeb7:"
