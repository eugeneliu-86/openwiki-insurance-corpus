        }
      ]
    },
    {
      "id": "claim_3e10af89a48441a0b674024ed41b706d",
      "statement": "North Carolina's NCDOI-2018-03 bulletin imposes disclosure and administrative requirements separate from contract coverage: when an applicable fungi limitation exists, an admitted property insurer must provide a clear, prominent, understandable, policy-consistent disclosure, make it available for new coverage before acceptance, update it for material renewal or policy changes, maintain delivery and control records, and remain responsible for agent or producer delivery.",
      "evidence": [
        {
          "resource": "repo://bulletins/NC/ncdoi-2018-03-fungi-disclosure.md#L13-L55",
          "version": "repo-lines-v1:sha256:404ec2255a7c1e7e4a5ba07d3c911307f2b32b431bddd4fd076d1e55589dee17:"
        },
        {
