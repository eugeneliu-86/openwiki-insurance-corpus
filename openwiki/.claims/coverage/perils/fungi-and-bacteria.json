        }
      ]
    },
    {
      "id": "claim_4f69a068603b4d8184f19f48aef45373",
      "statement": "For North Carolina claims involving alleged fungi loss, the bulletin requires fact review and reasonable investigation rather than an automatic denial, evaluation of whether a covered cause produced the condition, distinction between fungi damage and other covered damage, a clear written explanation for a limitation or partial denial, and preservation of the claim-file basis for the decision.",
      "evidence": [
        {
          "resource": "repo://bulletins/NC/ncdoi-2018-03-fungi-disclosure.md#L259-L299",
          "version": "repo-lines-v1:sha256:662f0fab5556a79c325db76887acd790019b1ca19197d266818f2f2a7e213c9f:"
        }
      ]
    },
    {
      "id": "claim_c2954cb02fd84ac8b8306632dcf4760f",
      "statement": "The fungi and mold claim-handling guidance is internal operational material rather than part of a policy contract; policy language, endorsements, and applicable law govern the coverage scope, and claim handlers must review applicable forms and endorsements before communicating a coverage position.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L13-L27",
          "version": "repo-lines-v1:sha256:81f0c731b25bb9cb0940c8824f0a6b54f70ec33f398bda5f6987005dff6d332c:"
        },
        {
