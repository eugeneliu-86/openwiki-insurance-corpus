    {
      "id": "claim_621cd37d9f4e48e599783b6b96abe414",
      "statement": "Under HO-3 2011-05, Section I S.1 requires prompt notice to the insurer or agent and protection from further damage, S.2 requires a signed sworn proof of loss within 60 days after insurer request, S.3 requires full compliance and suit within two years after loss, and S.4 applies the Declarations deductible to each Section I loss.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2011-05.md#L83-L92",
          "version": "repo-lines-v1:sha256:f67ae0773ef27dbd1d9b5bb1b3c09c502c17a00a493cc65ebaab694a7f8a7416:"
        }
      ]
    },
    {
      "id": "claim_929dd70528f645638b89c72cb01be3d3",
      "statement": "Under HO-3 2018-09, S.1 retains prompt notice and protection duties and adds an inventory of damaged personal property; S.2 retains the request-triggered 60-day sworn-proof requirement; and S.4 keeps the full-compliance and two-year action limitation.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2018-09.md#L101-L110",
          "version": "repo-lines-v1:sha256:5a7aa4271b00011c82c9c7cded23210c93506248bfb1c9e1b821fdf1d15dd630:"
        }
      ]
    },
    {
      "id": "claim_fa60e07a7ac0445480caf8e9f8d8d126",
      "statement": "The HO-3 2018-09 base-form payment provision is S.3: payment is due 60 days after receipt of proof of loss and written agreement, an appraisal award, or a court judgment, while 2011-05 S.1-S.4 contains no corresponding payment provision.",
      "evidence": [
