    {
      "id": "claim_621cd37d9f4e48e599783b6b96abe414",
      "statement": "Under HO-3 2011-05, Section I S.1 requires prompt notice to the insurer or agent and protection from further damage, S.2 requires a signed sworn proof of loss within 60 days after insurer request, S.3 requires full compliance and suit within two years after loss, and S.4 applies the Declarations deductible to each Section I loss.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2011-05.md#L83-L92",
          "version": "repo-lines-v1:sha256:f67ae0773ef27dbd1d9b5bb1b3c09c502c17a00a493cc65ebaab694a7f8a7416:"
        }
