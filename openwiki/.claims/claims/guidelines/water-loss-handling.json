    {
      "id": "claim_09ce1282880e43b282b1ee85d3b124cb",
      "statement": "For covered water-backup losses, HO 04 90 (2026-01) applies a $10,000 maximum for all endorsement loss in a policy period unless the Declarations show a higher limit, with the sublimit part of rather than additional to Coverage A, B, and C limits, and a separate $1,000 deductible for each endorsement loss; the base Section I deductible does not apply. DP 04 95 (2021-05) applies its own $5,000 aggregate limit and $1,000 deductible.",
      "evidence": [
        {
          "resource": "repo://forms/DP/MS/DP-04-95/2021-05.md#L113-L127",
          "version": "repo-lines-v1:sha256:ca045d29db9a0b99adf6b2b71c0a8f17f0690b35d32982c20e512ef8e44d9b52:"
