    {
      "id": "claim_8af1ed512647479a937c60150f0cf988",
      "statement": "When attached to an HO-3 policy, HO 04 90 (2026-01) provides coverage for direct physical loss to Coverage A, B, and C property caused by sewer or drain backup or sump discharge or overflow, including related equipment mechanical breakdown; it retains base exclusions for flood, surface water, and below-ground water, and adds known unremedied maintenance and operable backflow-device requirements for applicable finished below-grade areas. DP 04 95 (2021-05) supplies a separate DP-3 water-backup and sump-overflow grant subject to its own conditions and exclusions.",
      "evidence": [
        {
          "resource": "repo://forms/DP/MS/DP-04-95/2021-05.md#L13-L81",
          "version": "repo-lines-v1:sha256:7671270fe06a566402ddbadfbb8cf09b6a7eefc4057adc8a349183101437fadd:"
