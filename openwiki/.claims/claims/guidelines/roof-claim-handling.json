      "id": "claim_fa4da7e8b34a4d4f93a894895c2ef95a",
      "statement": "The 2018-09 HO 23 74 endorsement is superseded by the 2025-05 edition for policies effective on or after May 1, 2025, but remains applicable to policies written under the earlier edition; edition selection is based on the governing policy and endorsement, not the claim-adjustment date.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-23-74/2018-09.md#L1-L9",
          "version": "repo-lines-v1:sha256:d0f8a4cfa96d3f18fe253716d8bde2056ca9f8113d757a572d800ac1a0db9801:"
