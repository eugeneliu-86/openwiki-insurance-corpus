          "version": "repo-lines-v1:sha256:44cf2d36f412ba11fe817ca906c54826264e27a63f5de2ff0ae2bacf8853cb4a:"
        }
      ]
    },
    {
      "id": "claim_d4cdcbfef67d4e1a86b366b9e5c7da55",
      "statement": "The current Florida roof-age bulletin states that its 10-year ACV schedule administration cannot be applied unless the policy form authorizes the method and identifies the covered roof components; the earlier OIR-2019-11 bulletin is superseded for applicable later actions and used different historical thresholds.",
      "evidence": [
        {
          "resource": "repo://bulletins/FL/oir-2019-11-roof-age.md#L2-L9",
          "version": "repo-lines-v1:sha256:e95b56bf3d1bc6ff3f6838b59729c2b2c2832ce77a7ba850ca47abd15d59e6f4:"
