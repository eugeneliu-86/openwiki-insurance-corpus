        },
        {
          "resource": "repo://guidelines/claims/roof-claim-handling.md#L575-L671",
          "version": "repo-lines-v1:sha256:b9eb6a1867bba095a2484a471a5ec64d7ba4e5e803ea0cda99eb8bfb19fd3939:"
        }
      ]
    },
    {
      "id": "claim_7361aa1e2d5d4d9b8014e4c15bc23556",
      "statement": "Roof intake must record the report source, reported loss facts, property, insured, policy, and reported cause without characterizing the damage as covered before inspection; immediate mitigation should begin within 3 days after discovery and damaged materials should be retained when practical.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/roof-claim-handling.md#L465-L481",
          "version": "repo-lines-v1:sha256:ae1547e1e1e1132cf5f671f40e1d832731ea10da99012562f61596c4adfee6e6:"
        },
        {
