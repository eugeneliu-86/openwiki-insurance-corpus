    {
      "id": "claim_00a30393e7e64befbe4b17696c800f3a",
      "statement": "Roof scope must separate damaged roof surfacing from other roof components, interiors, contents, detached structures, source-component work, pre-existing or maintenance conditions, code work, matching, temporary protection, and other payment effects; the 2025 endorsement defines roof surfacing as the outermost weatherproof covering and separately addresses related components.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-23-74/2025-05.md#L137-L141",
          "version": "repo-lines-v1:sha256:f0009dd67b4d6a590d50e4cfaf8d0ff5d5fb8b1d782dad0f33cd703b69213c27:"
