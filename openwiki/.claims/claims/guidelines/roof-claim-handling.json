  "claims": [
    {
      "id": "claim_35070de30a144af2a688784a631c9830",
      "statement": "Roof claim handling guidance is internal operational direction: the applicable policy, endorsements, declarations, and law control coverage, and claim-specific facts and inspection findings must be evaluated rather than treating the guidance as a contract.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/roof-claim-handling.md#L13-L27",
          "version": "repo-lines-v1:sha256:5d1afbfb91687d964c04a667a3c019398995596eedfb64a3fe784eb008b58675:"
        },
        {
          "resource": "repo://manuals/claims/manual.md#L13-L49",
          "version": "repo-lines-v1:sha256:2e7f43191fc664a5188050823c09db4019e462a813053a8b6cd5cbc1f6279abf:"
        }
      ]
    },
    {
      "id": "claim_2314a552d4094b358a3033b8e3e645a1",
      "statement": "A roof claim lifecycle opens on notice, verifies the policy, acknowledges and protects property, preserves evidence, investigates cause and scope, escalates material uncertainty, values covered damage under the governing form, communicates and pays the supported amount, then supplements, reopens, or closes based on material new information.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/roof-claim-handling.md#L465-L523",
          "version": "repo-lines-v1:sha256:fd0341de1883c10bcc3e08223e90fbfe5e96e6f05283828f3249a2f5d9f9c8ea:"
        },
        {
