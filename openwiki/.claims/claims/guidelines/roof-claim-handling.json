    },
    {
      "id": "claim_a4e87f5450d2462784d25be159015062",
      "statement": "The roof guideline requires escalation before final payment above $10,000, while the general claims manual requires referral before settlement or payment commitment when evaluated exposure exceeds $25,000; unresolved causation, age, scope, code, matching, schedule, fraud, litigation, or authority issues also require escalation.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/roof-claim-handling.md#L431-L451",
          "version": "repo-lines-v1:sha256:ae21c4a0cea57468dfef8b0254af3c2c55645b9875ab7e0ef95f40d43066ca28:"
