    },
    {
      "id": "claim_8a619b1db4e04e0880fc38b40700e891",
      "statement": "Liability investigation requires neutral fact development from insureds, claimants, witnesses, records, inspections, experts, and physical evidence; handlers must distinguish allegations from confirmed fault, identify serious or specialized exposures, and preserve evidence before irreversible mitigation or repair when practical.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/liability-claim-handling.md#L567-L571",
