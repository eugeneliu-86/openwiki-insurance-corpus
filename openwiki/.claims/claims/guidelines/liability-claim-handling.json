    {
      "id": "claim_d63d2b94df61455f926099cc70a9d443",
      "statement": "Settlement and expense authority applies to total known exposure, including indemnity, allocated expense, anticipated defense cost, contribution, and related obligations; handlers must obtain authority before material commitments and may not split payments or approvals to evade referral.",
      "evidence": [
        {
