    {
      "id": "claim_e9d682c7e668423aaa2024717c2fa068",
      "statement": "When a potential coverage defense is identified, the liability guideline calls for a reservation of rights within 15 days, while the general claims manual states 10 days; the reservation must be fact-specific, is not a final coverage decision, and investigation should continue unless the coverage resource directs otherwise.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/liability-claim-handling.md#L551-L559",
