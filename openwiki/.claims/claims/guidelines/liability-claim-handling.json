    },
    {
      "id": "claim_97cfb316ba15498198740fbb22847af0",
      "statement": "Claims must be escalated for authority or coordinated review when they involve excess or disputed limits, severe or fatal injury, sensitive or public allegations, unusual coverage, nonstandard settlement terms, fraud or intentional conduct, specialized liability categories, material defense-strategy changes, or time-sensitive proceedings.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/liability-claim-handling.md#L635-L671",
