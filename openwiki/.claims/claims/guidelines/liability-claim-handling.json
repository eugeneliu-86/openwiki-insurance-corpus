    {
      "id": "claim_b9e350b762204f9db730bbd40f7f9e62",
      "statement": "Liability Claim Handling Guidance is internal operational direction: it organizes claim work but does not create, expand, restrict, or amend coverage; the applicable declarations, homeowners form, endorsements, facts, and law control contractual rights and obligations.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/liability-claim-handling.md#L13-L27",
          "version": "repo-lines-v1:sha256:7b60b63a82933fb51135c046e77f093a9425b7bd5454d70bd1ab844ac7ccbc20:"
        },
