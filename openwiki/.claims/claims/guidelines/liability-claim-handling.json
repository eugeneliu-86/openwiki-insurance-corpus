        }
      ]
    },
    {
      "id": "claim_c786c83ece6b4882b499141d4df45c4f",
      "statement": "The claims manual requires claim receipt acknowledgment within 15 days, treats liability notice received within 30 days as timely for internal triage, and requires escalation of delayed or time-sensitive matters; the liability guideline and general manual contain different internal reservation intervals that must be referred for an approved applicable standard rather than silently reconciled.",
      "evidence": [
        {
