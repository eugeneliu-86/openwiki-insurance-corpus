        }
      ]
    },
    {
      "id": "claim_874c59c38f82457e8e4df804c2b20d78",
      "statement": "A liability claim file must be opened on notice of an occurrence, offense, claim, or suit, with parties, occurrence details, allegations, service information, and supporting materials recorded and original evidence preserved.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/liability-claim-handling.md#L541-L549",
          "version": "repo-lines-v1:sha256:5d20c61dd40ff709e10307e4a91344020716c1fcb5bde8309b27ef0859a6cf6a:"
