    },
    {
      "id": "claim_3033f38b971e4c82998ae531659d7943",
      "statement": "Internal mitigation timing instructions conflict for mold or fungi exposures: Claims Manual Chapter 3 and the mold guidance direct reasonable mitigation within three days after discovery, while Chapter 9 describes a five-day-after-discovery threshold; the conflict is not a contractual deadline and should be escalated rather than communicated as a universal insured obligation.",
      "evidence": [
        {
