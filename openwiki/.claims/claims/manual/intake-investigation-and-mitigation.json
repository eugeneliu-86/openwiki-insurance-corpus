    {
      "id": "claim_715f41cdd91a4185b5cea10510843525",
      "statement": "A claim must not close while material coverage, payment, recovery, complaint, causation, or scope issues remain unresolved; closure requires a record of the classified event, inspections, findings, payments, and communications, and credible new information requires reopening after review of the prior file.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L1065-L1075",
          "version": "repo-lines-v1:sha256:8a3b45ff3da7cdb38e00672f947c53fbc3ab5709b7443f7a6ba8c100693f835a:"
