        }
      ]
    },
    {
      "id": "claim_093184d5d4064cc490c6fa921c25add2",
      "statement": "Roof-related reports use the general claims workflow with a specialty handoff: the roof procedure requires inspection of accessible roof surfaces, related components, affected interiors, weather and comparative evidence, prior-repair review, and qualified review when cause, scope, or repair feasibility is unresolved; contractor input remains scope or pricing evidence rather than coverage authority.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/roof-claim-handling.md#L487-L503",
          "version": "repo-lines-v1:sha256:87d0ef392cb3e3adeb3563a4eee25874c3be80eb4d3f6d7f9e18689d014d37c2:"
