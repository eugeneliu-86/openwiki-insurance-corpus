        }
      ]
    },
    {
      "id": "claim_6177d2f80c2a438390fd228552996b34",
      "statement": "Mold, fungi, wet- or dry-rot, and bacteria reports require a specialty exposure review that classifies the reported condition, traces the moisture source and chronology, separates reported facts from conclusions, and treats growth, odor, staining, moisture readings, health complaints, or vendor labels as evidence to evaluate rather than proof of covered microbial loss.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L37-L52",
          "version": "repo-lines-v1:sha256:45638798a56b0ff3301b2c78e821125bf1bdf85839378f39980e2a6a3b159357:"
        },
        {
          "resource": "repo://manuals/claims/manual.md#L3043-L3097",
          "version": "repo-lines-v1:sha256:af10633fb34b0d5474bd45d31ec820f0253928214ed96a37ba25da59625eff84:"
        }
      ]
    },
    {
      "id": "claim_83144e81f5a340888c72da0980c84c73",
      "statement": "Mold-related claim work must keep emergency protection, investigation, fungi work, permanent repair, and non-loss work separately traceable, preserve material evidence when practical, and escalate substantial contamination, bodily-injury or habitability concerns, unusual remediation, disputed causation, and other unresolved material issues.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L55-L83",
          "version": "repo-lines-v1:sha256:5efb83d5f356950a0dc823b1d33b4ad39a06df5ccc5ec16180848567f179ea72:"
        },
        {
