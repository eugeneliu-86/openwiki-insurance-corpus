        }
      ]
    },
    {
      "id": "claim_ac6ef3c151134444a041100bbbb9b146",
      "statement": "The manual requires coverage analysis and damage evaluation to remain distinct: an estimate measures claimed damage but does not establish policy response, and the file must separately document coverage issues, valuation issues, and unresolved payment issues.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L63-L73",
          "version": "repo-lines-v1:sha256:2816a7566996cd72f2d8af87745ab1f296561c86e1b74d875473fde0db3b8eac:"
