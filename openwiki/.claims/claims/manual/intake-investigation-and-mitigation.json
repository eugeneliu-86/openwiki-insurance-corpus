        }
      ]
    },
    {
      "id": "claim_71f9715d941b4327a1836f8b1b8618ef",
      "statement": "Before payment, the handler must verify affected property interests, apply the applicable deductible, use approved payees and payment methods, reconcile prior payments and recoveries, and avoid duplicate payment.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L111-L121",
          "version": "repo-lines-v1:sha256:a90fe11c02812ae5c20695a5fa2ef707c27e9e471d3b636f359fa4f20a7c5928:"
