    },
    {
      "id": "claim_6864289dc92d42c2abfdebc5c279bbc9",
      "statement": "Under HO-3 2024-03, sewer or drain backup and sump overflow are excluded unless a water-backup endorsement is attached, while accidental plumbing-system discharge is addressed separately; when HO 04 90 2027-01 is attached, its terms modify conflicting policy provisions and provide the endorsement's stated backup or sump coverage subject to its terms.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-90/2027-01.md#L16-L36",
          "version": "repo-lines-v1:sha256:e9c46d92b57b8b32be59cff3b3fe5e6b1958c9ca870b6b7d5be9f196a86e8bd1:"
