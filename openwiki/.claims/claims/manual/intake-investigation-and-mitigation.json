        }
      ]
    },
    {
      "id": "claim_62923f4e691f4ad6b4e40cb837b903f9",
      "statement": "Handlers must identify potential recovery opportunities, preserve evidence, avoid releases that impair recovery, document fraud indicators without accusation, and refer suspected misrepresentation or altered evidence through designated processes.",
