        }
      ]
    },
    {
      "id": "claim_bba0d4c485ca492cac45f58cec61094a",
      "statement": "The mold-handling guidance requires referral of a mold-related loss exceeding $10,000 before a coverage determination, while the general claims manual requires referral of an evaluated loss exceeding $25,000 before settlement or payment; these are distinct controls and must not be bypassed by splitting claim activity.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/mold-claim-handling.md#L109-L119",
          "version": "repo-lines-v1:sha256:a10f151f6ab8de17aafae5d760777aec2c511e0208e0357d1707152ee219f339:"
        },
