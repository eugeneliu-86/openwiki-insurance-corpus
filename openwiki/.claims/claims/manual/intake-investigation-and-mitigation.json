    {
      "id": "claim_6db78c57a643476681244cab4d5c8a26",
      "statement": "The HO 04 90 2027-01 endorsement requires notice within 30 days after discovery and imposes duties concerning reasonable protection, access, preservation, evidence, and mitigation; those policy duties must be analyzed for the endorsement actually attached and are not replaced by the internal three-day handling instruction.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-90/2027-01.md#L791-L819",
          "version": "repo-lines-v1:sha256:a5eb0f54f5596cf89ffe693bd9a78f493a709ea2593ae2733ed651f948933c9d:"
