  "claims": [
    {
      "id": "claim_8c78bc131046466a8bf5b80e563dc4ce",
      "statement": "The Property Claims Handling Manual is internal direction for assigned property claims: the handler must act within the assigned role and authority, document role and restrictions, and may not alter policy terms, waive conditions, or create coverage through claim correspondence.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L15-L19",
          "version": "repo-lines-v1:sha256:6fd5dda89a77d8c405b682b6346bf32a694ad182d7999c9cf04d18bd44e206fc:"
        },
        {
          "resource": "repo://manuals/claims/manual.md#L51-L55",
          "version": "repo-lines-v1:sha256:0a1fc50320b7a434bc633a6c2d9659a9784b7da562d63bf1fe964084e1305571:"
        }
      ]
    },
    {
      "id": "claim_ed38b07a3e3048f9b8fc0d5005c8bd9d",
      "statement": "Any communication asserting property damage, loss, or a request for benefits is treated as claim notice without formal wording; intake opens a claim record and captures the notice source, reported facts, assigned identifier, handler, location, date, and unresolved information.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L389-L407",
          "version": "repo-lines-v1:sha256:39f68911ca923e8178b09a1395163c682b1b3cf9348a91eb547b93104f1f151b:"
        }
      ]
    },
    {
      "id": "claim_70d040fc0df74a83b9c9a35775448c31",
      "statement": "Intake must acknowledge receipt without making a coverage conclusion, meet the applicable acknowledgment deadline, use plain next-step language, and document the communication and recipient.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L429-L439",
          "version": "repo-lines-v1:sha256:02d53e3a64f308401d0f09c4883aeef9ab2f7114ff05467996f87b9b8f5ddb72:"
        }
      ]
    },
    {
      "id": "claim_d462fac76960421193ee8f00bbba560e",
      "statement": "When known facts may limit or preclude coverage while investigation must continue, the handler must issue an approved, fact-specific reservation of rights within 10 days, distinguish it from denial or acceptance, and continue necessary investigation and mitigation unless an authorized coverage resource directs otherwise.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/water-loss-handling.md#L487-L499",
          "version": "repo-lines-v1:sha256:0134c4a1c39081df0f441d22a2d946c790437e65e9d34354a63df9d57733e816:"
        },
        {
          "resource": "repo://manuals/claims/manual.md#L481-L511",
          "version": "repo-lines-v1:sha256:bfde3fd96e843dd12396970ff9f4077c1cc0762e5827bd6d752e9961013c33c3:"
        }
      ]
    },
    {
      "id": "claim_7f59d841e8ab449d84f5da5d4872f650",
      "statement": "For water losses, the manual requires prompt mitigation and, when covered water affects insured property, mitigation to begin within three days after discovery; emergency protective measures remain subject to assigned authority and do not constitute acceptance of the full claim.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/water-loss-handling.md#L591-L605",
          "version": "repo-lines-v1:sha256:7636898d62251f76545bc4c0e5c98ffb088dc6e59f82bd66b20a8b1dd6b16c33:"
        },
        {
          "resource": "repo://manuals/claims/manual.md#L709-L727",
          "version": "repo-lines-v1:sha256:c12ab8ce401254edfef88a88f1f5cabac19349415be3e87b369fb240740b0889:"
        }
      ]
    },
    {
      "id": "claim_863353f1e8a746629b6f18945b62e89e",
      "statement": "A water-loss coverage position must follow source and entry-path investigation, including whether water came from inside or outside, and must assess timing for a sudden and accidental event versus uncertain duration, repeated leakage, or progressive deterioration, with material uncertainty referred.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L717-L751",
          "version": "repo-lines-v1:sha256:205071c82d453c1988ee78b5313eb65846643b88b3c3693e2c2df50dff67754d:"
        }
      ]
    },
    {
      "id": "claim_22db3d891e49415d81b9c7cf83ba8da7",
      "statement": "Water-loss investigation requires inspection before demolition when conditions permit, preservation of representative evidence when emergency work prevents complete inspection, inspection of associated components, and qualified findings when the source cannot be reliably identified.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L735-L757",
          "version": "repo-lines-v1:sha256:6ff62933d4a77007c6f44092ae5712ae6e34866a6157a160b83288bb98d7798b:"
