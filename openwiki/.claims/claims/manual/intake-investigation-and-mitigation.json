        }
      ]
    },
    {
      "id": "claim_b3d2d445b08248f580ffe87d89ffa56d",
      "statement": "Claim handling must separate damage caused by water from damage to the failed part, distinguish emergency stabilization from permanent repair, and connect mitigation charges and reconstruction scope to supported damage rather than unrelated maintenance, renovation, or betterment.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L1023-L1027",
          "version": "repo-lines-v1:sha256:45b0c5ea97d42585841b2546904bb949f42d63628e82327c00bc4f729959fa3b:"
