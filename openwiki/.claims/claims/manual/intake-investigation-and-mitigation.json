        }
      ]
    },
    {
      "id": "claim_62bbdcb83fa949b8b525b08cd83b5117",
      "statement": "An evaluated property loss above $25,000 requires referral before settlement or payment commitment; authority applies to total claim exposure, cannot be avoided by dividing activity, and investigation or expense authority is distinct from indemnity authority.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/water-loss-handling.md#L591-L611",
          "version": "repo-lines-v1:sha256:bc4bfd7ed7257f3935a0258244b1cd686c7acded37cc039c6a5d2129e58f57ed:"
