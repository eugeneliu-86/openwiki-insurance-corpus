        }
      ]
    },
    {
      "id": "claim_1536b365fe0542fba1351cb394128650",
      "statement": "In a condominium loss, ownership, repair responsibility, and insurance responsibility can differ; the adjuster must compare the declaration, master policy, unit-owner policy, endorsements, repair history, and evidence rather than treating an association decision, maintenance rule, contractor invoice, or non-filing of a master-policy claim as a coverage conclusion.",
      "evidence": [
        {
