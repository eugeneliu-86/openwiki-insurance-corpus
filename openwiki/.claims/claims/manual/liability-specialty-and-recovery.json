    {
      "id": "claim_b6ac6e6c063b4d909fb77c6101d4ec9a",
      "statement": "When attached, the HO 04 35 2023-02 endorsement provides up to $25,000 for a legally chargeable and properly allocated association assessment arising from covered Direct Physical Loss to Collective Property, a covered Master Policy deductible, or covered Property Damage for which the Association is legally liable; it requires assessment and allocation support, applies the applicable policy deductible only to the covered amount, reduces payment by legally available recovery, and excludes maintenance, improvement, invalid or voluntary charges, excluded causes, and other amounts not legally chargeable to the insured.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-35/2023-02.md#L243-L273",
