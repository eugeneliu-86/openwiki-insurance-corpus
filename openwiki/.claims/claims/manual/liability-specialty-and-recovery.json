    {
      "id": "claim_b6ac6e6c063b4d909fb77c6101d4ec9a",
      "statement": "When attached, HO 04 35 provides up to $25,000 for a legally chargeable association assessment arising from covered direct physical loss to collective property, a covered master-policy deductible, or covered liability, but requires proof of the assessment and allocation and excludes maintenance, improvement, invalid or voluntary assessments, excluded causes, and amounts available from other recovery sources.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-04-35/2023-02.md#L141-L199",
          "version": "repo-lines-v1:sha256:19605deee8b65ab45a49f21055408ab18e0f724aba9f29d45f40c64071d0fc95:"
