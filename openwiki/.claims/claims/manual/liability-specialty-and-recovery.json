    {
      "id": "claim_3c0c7bbfa4b04261b76186a22266a6d2",
      "statement": "The claims manual requires a claim file to be opened on notice, with the reported parties, location, date, affected interest, policy status, authority, evidence, mitigation, communications, and unresolved facts documented before adjustment proceeds; an estimate or investigation is not itself a coverage decision.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L15-L103",
          "version": "repo-lines-v1:sha256:ebad12f0a6261a99813ab8c7196bc785f7f1084f72829dda53bc2257acab3874:"
        },
        {
