    {
      "id": "claim_224e8197dc934428b2ad1d37d2a9f22a",
      "statement": "The current HO-3 base form provides loss-assessment coverage only when the assessment results from direct loss to association property caused by a peril insured against under Coverage A, limits payment to $2,000, and applies the deductible applicable to the direct property loss.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L449-L463",
          "version": "repo-lines-v1:sha256:074ee834ccea544aef1ae98631d5a133e9ca6ec9edd96e2a5e33968c916ff672:"
        }
      ]
    },
    {
      "id": "claim_e55f54be21724edea7f8f184b1c2e8b1",
      "statement": "The current HO-6 base form states a $2,000 maximum for loss assessment and requires assessment handling to follow its applicable assessment conditions, including prompt notice, supporting records, and the form's exclusions and settlement provisions.",
      "evidence": [
