  "claims": [
    {
      "id": "claim_3c0c7bbfa4b04261b76186a22266a6d2",
      "statement": "The claims manual requires a claim file to be opened on notice, with the reported parties, location, date, affected interest, policy status, authority, evidence, mitigation, communications, and unresolved facts documented before adjustment proceeds; an estimate or investigation is not itself a coverage decision.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L15-L103",
          "version": "repo-lines-v1:sha256:ebad12f0a6261a99813ab8c7196bc785f7f1084f72829dda53bc2257acab3874:"
        },
        {
          "resource": "repo://manuals/claims/manual.md#L389-L467",
          "version": "repo-lines-v1:sha256:8ad70774f80a08c5e2cea5b9177536dc0d571984b20a1e8a7b741c1f09e326e8:"
        }
      ]
    },
    {
      "id": "claim_5f97077856e2485d9482fa4419596a6b",
      "statement": "Liability handling begins by identifying the occurrence, alleged bodily injury or property damage, insured, claimant, witnesses, evidence, and repair information, while keeping alleged fault separate from confirmed fault and referring serious or technically complex exposures before material disposition.",
      "evidence": [
        {
          "resource": "repo://manuals/claims/manual.md#L2527-L2681",
          "version": "repo-lines-v1:sha256:1e380b5a85fd9db6359f441c6250c12b127fb891bbb673ce290bb8d70c9e85e8:"
        }
      ]
    },
    {
      "id": "claim_1017f97b30c84525b291b83699fe9952",
      "statement": "Under the current HO-3 Coverage E wording, personal liability responds to damages for which an insured is legally liable because of bodily injury or property damage caused by an occurrence and provides a defense for a covered claim or suit, subject to the form's exclusions and duties including prompt notice, forwarding legal papers, cooperation, and consent before voluntary payment or assumption of an obligation.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L1023-L1071",
          "version": "repo-lines-v1:sha256:a8961c6b2ee200dec68d5d9a0dbca79940416bd365477d1e7e1aca91544719ae:"
        }
      ]
    },
    {
      "id": "claim_2d22718d4800495ea95ac7216d71fef9",
      "statement": "Liability coverage analysis must remain separate from first-party property settlement concepts such as roof age, property deductibles, coinsurance, and repair estimates; the liability guidance treats policy language and liability facts as controlling rather than treating property handling conclusions as fault or coverage conclusions.",
      "evidence": [
        {
          "resource": "repo://guidelines/claims/liability-claim-handling.md#L229-L255",
          "version": "repo-lines-v1:sha256:d993b9667bf0f433eb120e1db25f13c54ca74b949b4aacb8602415e7b1733086:"
        },
        {
