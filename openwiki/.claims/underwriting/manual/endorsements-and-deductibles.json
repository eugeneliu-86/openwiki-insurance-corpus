      "id": "claim_5160af9578a04d59b9a1ba8ccdde57c4",
      "statement": "Rule 400 requires review of every requested endorsement before binding or renewal, attachment only for an eligible risk supported by current and complete information, matching to the named insured, location, and insured property, and referral or suspension when eligibility or material facts are uncertain.",
      "evidence": [
        {
          "resource": "repo://manuals/underwriting/manual.md#L5097-L5149",
          "version": "repo-lines-v1:sha256:f2ef2318a246a0483b9caa4c301079120f5c60c6427a5e5bd898f5e25228d513:"
        }
      ]
    },
