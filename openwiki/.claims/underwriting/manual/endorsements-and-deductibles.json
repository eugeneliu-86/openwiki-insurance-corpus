    {
      "id": "claim_8dbdc848ada341ac8dd7ad51923ed0ac",
      "statement": "Rules 400 and 410 are internal underwriting controls: they govern whether an endorsement or deductible option may be selected and issued, but they do not grant coverage, change a policy deductible, or replace the applicable policy forms and endorsements.",
      "evidence": [
        {
          "resource": "repo://manuals/underwriting/manual.md#L21-L37",
          "version": "repo-lines-v1:sha256:3c1146fcffb84e45f209bc9eed99ffc7e9fa8d1c91e5443e0a5497cc3cecf6df:"
