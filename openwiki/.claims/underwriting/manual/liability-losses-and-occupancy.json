        }
      ]
    },
    {
      "id": "claim_a271134e02594e148281309abb723683",
      "statement": "Rule 230 requires referral for material premises-liability hazards including unsafe pools and water features, recreational and elevated structures, animals, weapons or explosives, business or visitor activity, rental or lodging, hazardous property conditions, and unresolved premises disputes.",
