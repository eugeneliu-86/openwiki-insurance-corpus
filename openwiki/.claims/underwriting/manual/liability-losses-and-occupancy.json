        }
      ]
    },
    {
      "id": "claim_95910981d6ad418c9637c679c62b7674",
      "statement": "A pending referral is not approval: the underwriter must hold the affected binding, renewal, change, or endorsement action, use an authorized recorded channel, and satisfy approval conditions exactly before acting.",
