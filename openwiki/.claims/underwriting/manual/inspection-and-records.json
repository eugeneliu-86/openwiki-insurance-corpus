        {
          "resource": "repo://manuals/underwriting/manual.md#L8503-L8507",
          "version": "repo-lines-v1:sha256:9c723676b51c6732adb956fdd1aaf2e8885ef582a42fb7b23af91c250a33a73f:"
        }
