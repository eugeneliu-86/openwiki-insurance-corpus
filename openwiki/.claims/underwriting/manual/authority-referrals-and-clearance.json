    {
      "id": "claim_e03761a3ced545e08a3ffc27416ef86f",
      "statement": "Before binding, Rule 300 requires verification of effective date, identity, insurable interest, occupancy, location, territory, material hazards and loss information, claim activity, property condition, valuation, coverage fit, deductible, and material rating information; unresolved material conflicts are referral conditions.",
      "evidence": [
        {
          "resource": "repo://manuals/underwriting/manual.md#L4017-L4111",
          "version": "repo-lines-v1:sha256:0a0cf984daa29a2987142a4f6ca54c16a50d2a576e03cdbb54f28193a79dee6d:"
