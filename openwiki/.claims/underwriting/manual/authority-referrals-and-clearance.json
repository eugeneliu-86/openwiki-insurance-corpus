        }
      ]
    },
    {
      "id": "claim_f6e6da5d8a24496b8b2639e4ffb2befd",
      "statement": "Rule 300 requires the risk to be within active delegation and requires a documented approval before a referred risk is bound; pending, verbal, changed, inactive, backdated, split, or transaction-sequenced handling cannot substitute for authorized terms.",
