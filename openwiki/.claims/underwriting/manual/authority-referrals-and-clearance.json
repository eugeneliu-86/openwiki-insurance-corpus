  "claims": [
    {
      "id": "claim_d9a4afccb1f24059a81fa133bdd07a7c",
      "statement": "The Personal Lines Underwriting Manual and referral matrix are internal operational guidance rather than policy terms or coverage grants; binding and coverage decisions must remain separate from the applicable policy form, declarations, endorsements, and other controlling requirements. A referral is a request for authorized direction, not approval, declination, or a transfer of responsibility for the file.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L13-L19",
          "version": "repo-lines-v1:sha256:9cadb27e75da9caa894eb166cdf5ac2d4b6f39c075438c90647e4c86bd87e9ee:"
        },
        {
