          "version": "repo-lines-v1:sha256:3d49e53083a482d727f10c22844a715d4ebd216e331a9bd013d016fdd337687e:"
        }
      ]
    },
    {
      "id": "claim_f3414f2d0d414f328c713ec5f123f01b",
      "statement": "Rule 300 sets two Coverage A delegated ceilings: a line underwriter may bind through $800,000 and a senior underwriter may bind through $1,500,000; requests above the applicable ceiling must be referred and the requested amount and authority used must be recorded.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/referral-matrix.md#L695-L716",
          "version": "repo-lines-v1:sha256:85bbbfd30419e9ea4c92fa51fa9584abffb5ace8d86f8f3b2f7715d3ae966575:"
