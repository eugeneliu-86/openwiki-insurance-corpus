    {
      "id": "claim_ab9ab55759a8446cb3249fddc71fa7ab",
      "statement": "Rule 310 makes a reported loss at or above $100,000 a mandatory underwriting referral with binding held pending disposition, and separately requires referral for open or disputed claims, bodily-injury or property-damage allegations, negligent supervision, intentional conduct, pending litigation, and demands indicating a potential claim.",
      "evidence": [
        {
          "resource": "repo://manuals/underwriting/manual.md#L4413-L4467",
          "version": "repo-lines-v1:sha256:c829094de085c3c2ed3bb4bd197f22e232886e40576d29663720468426a3df4d:"
        }
      ]
    },
    {
      "id": "claim_2a791bb94fa14466818986c7b44893ba",
      "statement": "Rule 310 requires referral for adverse prior underwriting actions, hazard-related declines by another carrier, inconsistent application information, suspected material misrepresentation, unverifiable ownership, and trust, estate, or similar ownership arrangements.",
      "evidence": [
        {
          "resource": "repo://manuals/underwriting/manual.md#L4469-L4509",
          "version": "repo-lines-v1:sha256:7e41733661a219c96471703302442296deb2fa1b749af3fb31118d29f58d49b5:"
