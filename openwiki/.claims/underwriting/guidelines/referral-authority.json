        }
      ]
    },
    {
      "id": "claim_432ca5c6fa44426e9f922ae82180e3bb",
      "statement": "The Matrix requires referral when material risk facts cannot be reconciled, unusual occupancy, condition, protection, or loss characteristics affect the decision, or available information does not support a confident authority determination.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/referral-matrix.md#L193-L197",
          "version": "repo-lines-v1:sha256:d2a7e4c303902d1498c88171b779ea4e32c715bcba0eafebcaf7a52f176f8575:"
