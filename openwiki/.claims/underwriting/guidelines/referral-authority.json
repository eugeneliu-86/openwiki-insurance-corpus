  "claims": [
    {
      "id": "claim_832a90ea981a448bbd71eb77807f2a0c",
      "statement": "The Underwriting Referral and Authority Matrix is internal underwriting and claims guidance rather than an insurance contract, and it cannot create, expand, restrict, or waive coverage; applicable policy terms control coverage and payment.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/referral-matrix.md#L13-L25",
          "version": "repo-lines-v1:sha256:1783fb02ee30602fe8d730c220311746db6c5b1b03f8fd8a0dafd7ab8997f3dd:"
        }
      ]
    },
    {
      "id": "claim_802050af545f42ee971d2edaa14ddc20",
      "statement": "A referral is a request for direction rather than an automatic approval, declination, coverage grant, or transfer of file responsibility; silence, delay, informal discussion, or an incomplete response does not constitute approval.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/referral-matrix.md#L23-L35",
          "version": "repo-lines-v1:sha256:724bfac24343af7ec093b1fd0b8632ec1bbb0f3e94258e352d7e23aebff17706:"
        },
        {
          "resource": "repo://guidelines/authority/referral-matrix.md#L45-L55",
          "version": "repo-lines-v1:sha256:7f301d0ef07a69baf23b94cced94c52c4b044e775158e511c7a6949a8fca4631:"
        }
      ]
    },
    {
      "id": "claim_4858144ff6f849c4b03f0ba8ef1dfd41",
      "statement": "Line underwriting may bind Coverage A up to and including $800,000, senior underwriting may bind up to and including $1,500,000, and requests above the applicable authority must be referred before binding.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/referral-matrix.md#L695-L707",
          "version": "repo-lines-v1:sha256:5ae39b06e7067b60dd774be205d5556ea880ec1f1a0fad7dd3c9ff9c1fcc059b:"
        }
      ]
    },
    {
      "id": "claim_c7bc8bcd750a4d37a4019cd74a3b1d23",
      "statement": "Coverage A authority is applied to the amount actually requested at binding and cannot be bypassed by informally reducing the limit, splitting related transactions, relying on another account's approval, or changing approved terms without renewed authorization; endorsements affecting Coverage A remain part of the authority review.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/referral-matrix.md#L709-L749",
          "version": "repo-lines-v1:sha256:7a811a60c9eab171e84c2ec935b93af114ba11f14dee2609f97ab5ad9310723d:"
        },
        {
          "resource": "repo://guidelines/authority/referral-matrix.md#L775-L788",
