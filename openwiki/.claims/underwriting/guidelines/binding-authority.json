  "claims": [
    {
      "id": "claim_3d30b6f7c77747aa916bcd0d5fdcf998",
      "statement": "Binding Authority and Exceptions is internal underwriting guidance that constrains binding and attachment decisions but is not policy-contract language, does not determine eligibility by itself, and cannot replace applicable policy language or law.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L13-L37",
          "version": "repo-lines-v1:sha256:a90046ce23daab11896efa7812eff3e4a31c089058a92742b11c193ed12d2eb3:"
        },
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L13-L25",
          "version": "repo-lines-v1:sha256:9b1b8ec26a8bc4f85e55433f422615a53734539343f6d787aa774705cacc049d:"
        }
      ]
    },
    {
      "id": "claim_bcfe20548fd8403bb293882488db8310",
      "statement": "The guideline's authority lifecycle requires complete and reliable facts, comparison with active delegation, a hold and referral when authority or facts are unclear, express documented direction, and binding only within approved terms; silence, informal discussion, or an incomplete response is not approval.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L37-L57",
          "version": "repo-lines-v1:sha256:de12d5749e70b339ac528e352c813e77f8c63aa6fad84c7d920f4194974d2a4b:"
        },
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L649-L695",
          "version": "repo-lines-v1:sha256:a30cfb73edc3dcc9181600278be576d30768bb1fb17a8bd136cfa1fa3ee6ff73:"
        }
      ]
    },
    {
      "id": "claim_04945da71250446fb43e38537b238c3b",
      "statement": "The guideline sets Coverage A delegated ceilings of $800,000 for a line underwriter and $1,500,000 for a senior underwriter, requires referral above the applicable ceiling before issuing a binder, prohibits splitting related exposure or offsetting Coverage A with another coverage, and requires approval for post-bind limit increases.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L599-L615",
          "version": "repo-lines-v1:sha256:3e261cbe29a99db58ef23f685b4e202c985415f556c81112ce3d0dfae38e528f:"
        }
      ]
    },
    {
      "id": "claim_47f7840fece5423fb745a088495263d8",
      "statement": "Before binding, the guideline requires verification of identity, insurable interest, territory, occupancy or use, condition, protective features, losses, limits, deductible, premium and payment handling, notices, endorsements, active authority, and approved-system processing; material endorsement or wording changes require authority rather than routine discretion.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L61-L151",
          "version": "repo-lines-v1:sha256:57cdf5d40ef65137aa8bdca0e49a3b899562cddf93b8f0857998b68bb7161931:"
        },
        {
          "resource": "repo://manuals/underwriting/manual.md#L4017-L4045",
          "version": "repo-lines-v1:sha256:7fc87f3ff2a3d35d47a9ad3d526ecdcac7e00be0db5fbcccfa76308a94ea165f:"
        },
        {
          "resource": "repo://manuals/underwriting/manual.md#L4113-L4123",
          "version": "repo-lines-v1:sha256:70abb8108acec9d5b8463e43b0b7a41adc285697db4fb4e374cdef9986dee856:"
        }
      ]
    },
    {
      "id": "claim_fa2afa53e4784c70a72da07ab90bf66f",
      "statement": "The guideline requires roof-condition evidence and referral for unreliable or conflicting roof information, damaged or improperly installed materials, active or recurring damage, compromised drainage or flashing, unresolved interior moisture, structural irregularity, near-end-of-useful-condition surfacing, or an active leak without an authorized exception; a stated repair is not proof of a sound roof.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L155-L213",
          "version": "repo-lines-v1:sha256:ad2bbccd5fd6a870c04eed2c3c029ae759e040eadef1fa78a487cceda79f61b2:"
        },
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L217-L275",
          "version": "repo-lines-v1:sha256:6000c67662b69bd336644d40e2410352462430be2c1b5d2a1423770152580724:"
        }
      ]
    },
    {
      "id": "claim_1b9f18fd07c14eb2979a1e2437bdd112",
      "statement": "For wind and hail, the guideline requires a wind mitigation inspection before binding Coverage A above $1,000,000, requires review that the inspection matches the property and is consistent with other evidence, requires referral for specified deterioration, damage, protection, construction, occupancy, or coverage-removal concerns, and requires documented approval for deductible exceptions or outstanding information.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L277-L351",
          "version": "repo-lines-v1:sha256:50a19a9914754451e33b1ca3d62b2b3f5374a009edca28010a201f8698483a75:"
        }
      ]
    },
    {
      "id": "claim_770475f11bec4fc2b7f2367c7e99b285",
      "statement": "For water backup, the guideline requires cause-specific review of drainage, sewer, sump, surface-water, flood, and groundwater facts, prior intrusion and repairs, and endorsement attachment; it prohibits treating all lower-area water as backup, combining causes without attribution, or promising payment before evaluation, and requires preservation of supporting cause and damage evidence.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L681-L691",
          "version": "repo-lines-v1:sha256:815c744f649bb83a640a86a1b7dd4a27f4e11e2d7212d284d52fa21ab3d1165d:"
        },
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L353-L429",
          "version": "repo-lines-v1:sha256:93bc23307c583414a3334df9c399d6382af6d8ebdf20e5f3ede64d6e3872d277:"
        }
      ]
    },
    {
      "id": "claim_5622cf28f7f8421da73a805227d5cf31",
      "statement": "For prior losses, the guideline requires complete information before binding or changing coverage, treats paid, denied, open, disputed, unpaid, reported, and known-circumstance matters as potentially relevant, requires cause, status, corrective-action, recurrence, and source details, and prohibits binding or coverage changes to avoid a pending or newly discovered referral.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L431-L515",
          "version": "repo-lines-v1:sha256:9bce475bc61b54a447fe9bb1c86f34ca4457fe0465d1c50c6b25e25c83268069:"
        }
      ]
    },
    {
      "id": "claim_59df32e3473c4deea36621af233dafcf",
      "statement": "An exception must identify the requested departure, risk concern, decision requested, and supporting evidence; only an authorized reviewer may accept an exception beyond the handler's authority, and approval must be documented, verifiable, recorded before binding, consistently applied, and followed exactly without unapproved changes.",
      "evidence": [
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L105-L111",
          "version": "repo-lines-v1:sha256:f9a81312dd57434a7ccd7ef631b8ed3961bc4b14ff21d15a0d7838b8d8c2125a:"
        },
        {
