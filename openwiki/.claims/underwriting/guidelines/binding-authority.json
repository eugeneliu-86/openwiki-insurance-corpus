          "version": "repo-lines-v1:sha256:de12d5749e70b339ac528e352c813e77f8c63aa6fad84c7d920f4194974d2a4b:"
        },
        {
          "resource": "repo://guidelines/authority/binding-authority.md#L649-L695",
          "version": "repo-lines-v1:sha256:a30cfb73edc3dcc9181600278be576d30768bb1fb17a8bd136cfa1fa3ee6ff73:"
        }
      ]
    },
    {
      "id": "claim_11815d82eb1b4d0792ce03ef02cba9ed",
      "statement": "The binding-authority file must preserve the authority basis, requested Coverage A and valuation, active authority status, evidence, conditions, referral or exception reason, information supplied for review, approver and approved terms, communications, follow-up, and final disposition so another reviewer can reconstruct the decision.",
