    {
      "id": "claim_1097447fce524a799f66b13e40fb9bf0",
      "statement": "Manual Rule 400 makes endorsement attachment a separate underwriting control: the requested coverage must be supported by current risk facts and eligibility, matched to the named insured, location, and insured property, supported by complete and nonconflicting information, and appropriate to the coverage intent; an endorsement may not be used to cure an ineligible risk.",
      "evidence": [
        {
          "resource": "repo://manuals/underwriting/manual.md#L5089-L5131",
          "version": "repo-lines-v1:sha256:5208868a410075c6ac7fd8fb4514a9fb1033fc5d5840ed2e2124340fd03b6075:"
        },
        {
          "resource": "repo://manuals/underwriting/manual.md#L5151-L5185",
          "version": "repo-lines-v1:sha256:8a6700410d950e8f046c92b08157165ffdb3390f6372d78388c6c71215a8607e:"
        }
      ]
    },
    {
      "id": "claim_cc673b5f70a24ae9aba20507edf72fdf",
      "statement": "Manual Rule 310 is a mandatory referral-and-hold path, including referral for a reported loss at or above $100,000 and for open or disputed claims, liability allegations, adverse underwriting history, unverifiable or inconsistent information, unusual ownership or use, property hazards, fraud indicators, adverse inspections, and other material hazards listed in the rule.",
      "evidence": [
        {
          "resource": "repo://manuals/underwriting/manual.md#L4413-L4509",
          "version": "repo-lines-v1:sha256:e99813b5489310246accc4c41c7fe8875982007f34d22b0e5b9152b1bbf72330:"
        },
        {
          "resource": "repo://manuals/underwriting/manual.md#L4511-L4761",
          "version": "repo-lines-v1:sha256:4c016ff55cb4546e90c10606c907201077c500cad793fa6603ec66ccf9d26df5:"
        }
      ]
    },
    {
      "id": "claim_ad3edf035b7447fab4b904502c8adbd3",
      "statement": "Manual Rule 320 requires decline when a known condition materially increases expected loss and cannot be corrected before binding, lists structural, roof, water, systems, premises, occupancy, information, environmental, access, protection, valuation, and commercial-use conditions, and sends an unlisted condition that cannot be cleared to referral under Rule 320.54.",
      "evidence": [
        {
          "resource": "repo://manuals/underwriting/manual.md#L4763-L5087",
          "version": "repo-lines-v1:sha256:aec806d40cd8149737b6f198b6b5fc3e5538ad9a41e50466bd3b62d5ef77c9e9:"
        }
      ]
    },
    {
      "id": "claim_3da3a3640f1547759afebab2a4365109",
      "statement": "Manual Rule 900 is a separate appendix control: it refers a reported loss exceeding $25,000 to claims authority, new business Coverage A above $1,500,000 to senior underwriting, requires three years of loss history before eligibility, sends roof age at or beyond 25 years to declination processing absent an authorized exception, and refers requested water backup above $25,000; it also lists nonnumeric referral triggers and does not replace Rules 300–320.",
      "evidence": [
        {
          "resource": "repo://manuals/underwriting/manual.md#L9865-L9895",
          "version": "repo-lines-v1:sha256:417c082f6d53620f8f9f38f74481da65aee35e66d23dee98d5430cc799fe5615:"
