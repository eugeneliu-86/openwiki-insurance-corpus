    {
      "id": "claim_9a1a05c074874025ae7c4b6a78b95e50",
      "statement": "For HO-6 (2023-02), ALE applies to the occupied part that is unfit because of covered loss and FRV to the rental part that is unfit; each ends when the relevant area is fit, and all loss-of-use payment also ends on repair/replacement and fitness or permanent relocation and is confined to the reasonable repair-or-replacement period.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-6/2023-02.md#L306-L324",
