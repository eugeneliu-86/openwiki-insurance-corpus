    {
      "id": "claim_76ff1485c68f4ec4bb41b6238c3f7e77",
      "statement": "For HO-3 (2024-03), a covered loss must make the residence uninhabitable for ALE; qualifying necessary increases can include temporary lodging, meals, related services, relocation, and temporary storage, but payment is limited to the uninhabitability period and may require proof of direct causation, uninhabitability, and amount.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L365-L373",
