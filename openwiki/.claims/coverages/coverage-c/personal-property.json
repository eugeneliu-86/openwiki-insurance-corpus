    {
      "id": "claim_84509cb19d224c5dac4838730ee49beb",
      "statement": "The Mississippi HO-3 2018-09 Coverage C grant covers personal property owned or used by an insured at the residence premises or elsewhere, sets the limit at 50% of Coverage A subject to special limits, and permits requested coverage for property of others only while at the residence premises.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2018-09.md#L231-L240",
          "version": "repo-lines-v1:sha256:42618561f305fe72991d7a8880542a1248fd0ec9bb1fda370749d6e012b5e66b:"
        }
      ]
    },
    {
      "id": "claim_9813c38c4eec4d45af0d2fc62a1c3201",
      "statement": "The Mississippi HO-3 2024-03 grants Coverage C for personal property owned or used by an insured anywhere in the world when usual or incidental to residence-premises occupancy; at the insured's request it may cover guest or residence-employee property at the residence premises under the stated conditions.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L219-L240",
          "version": "repo-lines-v1:sha256:be585d6ccb8748d83e1557dc3de2fe0eb5b8fcd79df11b3f12174c4f9ac3f44d:"
        }
      ]
    },
    {
      "id": "claim_931af57fde524adf984f3bb15ec0c412",
      "statement": "The Mississippi HO-6 2023-02 gives Coverage C worldwide treatment and separately extends coverage to property usually kept at a temporary residence and a qualifying student's property away from the residence premises; property-of-others coverage is request- and care-based and uses its own guest/residence-employee location wording.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-6/2023-02.md#L184-L203",
          "version": "repo-lines-v1:sha256:84b371fe5b4956c2602068cdef53f19dc067d2059058ca0003d0776632db739d:"
        }
      ]
    },
