    {
      "id": "claim_6f8b15a50ac8410abc5742c3fc4018e4",
      "statement": "The Mississippi HO-3 2024-03 Coverage E exclusions include expected/intended injury or damage, business and professional services, motor vehicles, aircraft/watercraft, contractual liability, workers-compensation-type obligations, specified owned/rented/controlled property, intentional loss, controlled substances, communicable disease, abuse, war, and nuclear hazard; its stated exceptions include reasonable protective force, nonbusiness-pursuit activity, a narrowly defined service vehicle, liability that exists absent contract, fire damage to rented property, and legitimate directed medication use.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L1037-L1063",
          "version": "repo-lines-v1:sha256:42c004c82089db0322ae4ca89d670b2a8376c6e3c252734f320bb9b1a4bfa6cc:"
        }
      ]
    },
    {
      "id": "claim_ad81ec8bc62c4aeeabf7973e437e8a40",
      "statement": "Under the Mississippi HO-3 2024-03, insureds must give prompt occurrence notice and details, promptly forward claim and suit papers, cooperate, avoid voluntary payment/obligation/expense without consent subject to the provision's reasonable-protective-expense exception, assist with evidence and witnesses, and transfer recovery rights to the extent of payment.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L1065-L1071",
          "version": "repo-lines-v1:sha256:8e9e599e5e2efbbc3263492c32d318b3e362f10900b75b26dbcd19642204c166:"
        }
      ]
    },
    {
