    {
      "id": "claim_a536fc0bac644570baa9317a25cc859b",
      "statement": "For the Mississippi HO-3 2024-03, Coverage E pays damages for which an insured is legally liable because of bodily injury or property damage caused by a covered occurrence; it applies to injury or damage from an occurrence at an insured location or from an insured's personal activities, caused during the policy period.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L1023-L1035",
          "version": "repo-lines-v1:sha256:57d1494a5963d6534032711aa26adffda2dda50aef780323e3d8499fd8fdbc3a:"
        },
        {
