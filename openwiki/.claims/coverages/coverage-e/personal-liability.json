        }
      ]
    },
    {
      "id": "claim_17dfab3e72ab47f7a75f9f5ac1bd7535",
      "statement": "The Mississippi HO-3 2024-03 provides defense at the insurer's expense for a claim or suit seeking covered damages, permits investigation and settlement, and ends the defense obligation when damage payments exhaust the applicable liability limit; it has no duty to defend non-covered damages.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L1025-L1032",
          "version": "repo-lines-v1:sha256:fe89408969860a4ebb6db4d635e1c014d02393c2d350f79f89f8e63ed7b90c5f:"
        }
      ]
    },
    {
      "id": "claim_e344dcc14df24b83894152f21e75ead7",
      "statement": "The Mississippi HO-3 2024-03 applies coverage separately to each insured without increasing the applicable liability limit.",
      "evidence": [
        {
          "resource": "repo://forms/HO/MS/HO-3/2024-03.md#L1033-L1035",
          "version": "repo-lines-v1:sha256:6b0d4853eaa72d8de48e41741b9e3fc3635fed6e55915572cd7615f4dcc3b656:"
