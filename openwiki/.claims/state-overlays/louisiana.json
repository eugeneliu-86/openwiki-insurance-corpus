    {
      "id": "claim_b6a435a1844a4c07a39305c1787bedf1",
      "statement": "Louisiana Bulletin LDI-2012-05 is superseded by LDI-2020-07 for policies effective on or after July 15, 2020, while remaining relevant to policies written under the earlier edition; LDI-2020-07 applies to affected personal residential property business issued, delivered, renewed, or modified on or after that date.",
      "evidence": [
        {
          "resource": "repo://bulletins/LA/ldi-2012-05-hurricane-deductible.md#L1-L9",
          "version": "repo-lines-v1:sha256:2716db2be795befbccd6efeda925e273fa5d4be9190913939c6d6b06318f8392:"
