          "version": "repo-lines-v1:sha256:ace09fd5b355dc30865b53a021970b0746590f254d82dc759979b898feee6bfa:"
        }
      ]
    },
    {
      "id": "claim_f2a507b6f2fb4f4fbea8ce30ac2c0f8c",
      "statement": "LDI-2020-07 requires clear deductible disclosure before binding and at renewal, retention of disclosure and delivery records, at least 30 days' advance written notice before a windstorm-deductible increase, and filing of hurricane-deductible and relevant named-storm language before use.",
      "evidence": [
        {
          "resource": "repo://bulletins/LA/ldi-2020-07-hurricane-deductible.md#L179-L197",
          "version": "repo-lines-v1:sha256:55f16876c4ce4a9cbd96d2588ee6681f0079a15ba6b903d06529166c38a08b9c:"
        },
        {
          "resource": "repo://bulletins/LA/ldi-2020-07-hurricane-deductible.md#L299-L331",
          "version": "repo-lines-v1:sha256:ce391e8d856b33516412de00ce3c72b8da4e4c1a23f905201576352ac809e44c:"
        },
        {
          "resource": "repo://bulletins/LA/ldi-2020-07-hurricane-deductible.md#L65-L99",
          "version": "repo-lines-v1:sha256:c215c3222a2fd817cdec3031804de6cece31538ca6adce2788c21c2e1134e2bf:"
        }
      ]
    },
    {
      "id": "claim_1d8f2646c373470ba8a9ebff5c725db7",
      "statement": "LDI-2020-07 requires a reasonable claim investigation, a documented determination that a period-dependent deductible applies only when policy terms and loss facts support it, separate evaluation of cause and deductible applicability, clear explanation of the deductible basis, sufficient claim-file records, and no storm-based reduction, delay, or denial of otherwise available coverage.",
      "evidence": [
        {
          "resource": "repo://bulletins/LA/ldi-2020-07-hurricane-deductible.md#L257-L297",
          "version": "repo-lines-v1:sha256:6bd592ae0f1be893783b91d437bcb4ebd9acfc44466bbbd6dd95e37f79fb25df:"
        }
      ]
    },
    {
      "id": "claim_cae57bbc65004fb8b33009e33bfb7425",
      "statement": "HO 01 17 sets the contractual windstorm-and-hail deductible at a 2% minimum and 5% maximum, applies it to covered direct physical loss caused or contributed to by windstorm or hail including covered wind-driven rain through a storm-created opening, allocates mixed causes by applicable portion, and treats related damage from one event as one occurrence while allowing separate weather events to be separate occurrences.",
      "evidence": [
        {
          "resource": "repo://forms/HO/LA/HO-01-17/2020-09.md#L59-L99",
          "version": "repo-lines-v1:sha256:430d2b95ca15322532ce2e752be8937626d2fd03d6a8e4dc801145b4a6233500:"
        }
      ]
    },
    {
      "id": "claim_492e39d9e41c40ac95a331c08a30d556",
      "statement": "HO 01 17 requires at least 30 days' notice before an increase in the windstorm deductible, requires the notice to identify the change and effective date, and applies a deductible change prospectively rather than to a loss that began before its effective date.",
      "evidence": [
        {
          "resource": "repo://forms/HO/LA/HO-01-17/2020-09.md#L211-L235",
          "version": "repo-lines-v1:sha256:9c19d0400fa2419f7c666d08f60e28c61e656ec1dd2f8673249ba8869bcb6868:"
        }
      ]
    },
    {
      "id": "claim_5adc6f367e62443d8e7f412c56f2bbbc",
      "statement": "HO 01 17 requires prompt notice of a possible named-storm loss, protection of property from further damage, preservation and inspection access for damaged property, cooperation, and supporting weather, photograph, receipt, repair, location, and condition information; a named-storm designation alone does not establish that all damage was caused by the storm.",
      "evidence": [
        {
          "resource": "repo://forms/HO/LA/HO-01-17/2020-09.md#L261-L309",
          "version": "repo-lines-v1:sha256:92b111d797c73010004667c6c466ec6d075b27f93c747bc54c6f8178c2dd4be8:"
        }
      ]
    },
    {
      "id": "claim_2bcbaf9b41764b28ba9ac96ef1802149",
      "statement": "HO 01 17 requires claim acknowledgment within 14 days, acceptance or rejection within 30 business days after all requested items are received, payment of an accepted claim within 30 business days, and commencement of legal action within two years after the date of loss, while imposing information, proof-of-loss, inspection, cooperation, and preservation duties.",
      "evidence": [
        {
          "resource": "repo://forms/HO/LA/HO-01-17/2020-09.md#L427-L461",
          "version": "repo-lines-v1:sha256:9b39ad1f37de89d44f9dbf0f434e947d441e25071f9747a563e37255964160ee:"
        },
        {
