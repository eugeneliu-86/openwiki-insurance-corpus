    {
      "id": "claim_306e7f55ebd24f96a5e0327186bca896",
      "statement": "HO 01 17 Louisiana 2020-09 is the contractual amendatory layer: when attached, it controls conflicts with the policy, preserves nonconflicting policy terms, and does not create coverage the policy does not otherwise provide.",
      "evidence": [
        {
          "resource": "repo://forms/HO/LA/HO-01-17/2020-09.md#L1-L7",
          "version": "repo-lines-v1:sha256:256fe64a6a4685c9fc06f06afa9205151348683e33b035a58e39c5b544c1c39f:"
