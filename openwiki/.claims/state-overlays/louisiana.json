        }
      ]
    },
    {
      "id": "claim_75adc2db0b9d4007a0f3bbe0f4065227",
      "statement": "Personal Lines Underwriting Manual Rule 540 is an internal pre-bind control rather than a coverage or regulatory term; its Louisiana-specific controls refer risks when the maximum windstorm-and-hail deductible percentage is unavailable or the submission is outside the internal named-storm window, limit unsupported credits, require referral of eligibility exceptions, and require retention of support for exception decisions.",
      "evidence": [
        {
