        }
      ]
    },
    {
      "id": "claim_dec31bc9e99643cf8cdf90c220ae9d10",
      "statement": "The HO 01 17 windstorm-and-hail deductible applies only to covered direct physical loss caused by windstorm or hail, must be between 2% and 5%, is determined under the policy terms at the time of loss, is applied before the payable amount, and does not raise a limit or create coverage.",
      "evidence": [
