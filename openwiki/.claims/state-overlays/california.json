    {
      "id": "claim_e18096173f68497e8e743364fad142fe",
      "statement": "CDI-2014-06 is effective 2014-06-30 and is superseded by CDI-2022-03 for policies effective on or after 2022-03-14, while remaining in force for policies written under the earlier bulletin; CDI-2022-03 applies from 2022-03-14 and requires procedures for effective-date application.",
      "evidence": [
        {
          "resource": "repo://bulletins/CA/cdi-2014-06-earthquake-offer.md#L1-L9",
          "version": "repo-lines-v1:sha256:cddb7783f2f45d8dd619db5429aeaa373c52527f40844f98eb6d125bd4b6a453:"
