    {
      "id": "claim_8d8177a9a4a0401fb798eda57fa4d9c1",
      "statement": "HO 01 04 supplies contractual timing controls distinct from CDI offer rules: deductible-change notice must precede application without a stated numeric advance period; cancellation requires at least 10 days for nonpayment or 20 days for another reason; nonrenewal requires at least 75 days before expiration; and claims have 15-day acknowledgment, 40-business-day decision-or-explanation, and 30-business-day payment periods.",
      "evidence": [
