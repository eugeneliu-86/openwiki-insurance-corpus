    {
      "id": "claim_6c7b1111c26745c6ba7d3fa67596dfec",
      "statement": "California’s earthquake overlay has separate regulatory and contract layers: CDI bulletins govern the insurer’s offer, notice, response, filing, records, and claims practices, while earthquake coverage still depends on the policy and an attached earthquake endorsement; internal underwriting guidance does not itself grant coverage.",
      "evidence": [
        {
          "resource": "repo://bulletins/CA/cdi-2022-03-earthquake-offer.md#L15-L35",
          "version": "repo-lines-v1:sha256:4322e07a4d1cfa15d9fce53a2930397c0c3db4751e67f50d80ba3ae7b9cf6575:"
