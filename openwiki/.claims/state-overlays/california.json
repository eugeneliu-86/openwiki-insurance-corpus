        }
      ]
    },
    {
      "id": "claim_1d93893e368e44caa63d6906331852b9",
      "statement": "The source set identifies HO 01 04 California Amendatory Endorsement 2021-06 as effective 2021-06-01 for California property and interests, with precedence over conflicting policy language to the extent permitted by California law.",
      "evidence": [
        {
          "resource": "repo://forms/HO/CA/HO-01-04/2021-06.md#L1-L27",
